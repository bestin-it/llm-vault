import { LineEdit, TextEdit, ComboBox, CheckBox, ListView, Slider, ScrollView } from "std-widgets.slint";
import { Theme, VButton, IconButton, Field, Label, Pill, EmptyState, Card } from "widgets.slint";
import { Store } from "store.slint";

export component PasswordsPage inherits Rectangle {
    background: Theme.bg;
    property <string> new-group;
    property <bool> adding-group;

    HorizontalLayout {
        padding: 18px;
        spacing: 14px;

        // ---------------- groups
        Card {
            width: 230px;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                HorizontalLayout {
                    Text { text: "Groups"; font-size: 14px; font-weight: 800; color: Theme.text; vertical-alignment: center; }
                    Rectangle { }
                    IconButton {
                        icon: @image-url("icons/plus.svg");
                        clicked => { root.adding-group = !root.adding-group; }
                    }
                }
                if root.adding-group: HorizontalLayout {
                    spacing: 4px;
                    LineEdit {
                        placeholder-text: "New group name";
                        text <=> root.new-group;
                        accepted => { Store.add-group(root.new-group); root.new-group = ""; root.adding-group = false; }
                    }
                }
                Rectangle {
                    height: 32px;
                    border-radius: 7px;
                    background: Store.selected-group == "" ? Theme.blue-soft : all-ta.has-hover ? Theme.subtle : transparent;
                    all-ta := TouchArea { mouse-cursor: pointer; clicked => { Store.select-group(""); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Image { source: @image-url("icons/search.svg"); width: 14px; height: 14px; y: (parent.height - self.height) / 2; colorize: Theme.muted; }
                        Text { text: "All entries"; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                    }
                }
                ListView {
                    for g in Store.groups: Rectangle {
                        height: 32px;
                        border-radius: 7px;
                        background: Store.selected-group == g.id ? Theme.blue-soft : gta.has-hover ? Theme.subtle : transparent;
                        gta := TouchArea { mouse-cursor: pointer; clicked => { Store.select-group(g.id); } }
                        HorizontalLayout {
                            padding-left: 10px + g.depth * 14px;
                            padding-right: 6px;
                            spacing: 8px;
                            Image {
                                source: g.provider ? @image-url("icons/key.svg") : @image-url("icons/folder.svg");
                                width: 14px;
                                height: 14px;
                                y: (parent.height - self.height) / 2;
                                colorize: g.provider ? Theme.teal-dark : Theme.muted;
                            }
                            Text { text: g.name; font-size: 13px; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            Text { text: g.count; font-size: 11px; color: Theme.faint; vertical-alignment: center; }
                        }
                    }
                }
                if Store.selected-group != "": HorizontalLayout {
                    spacing: 6px;
                    VButton {
                        text: "Delete group";
                        kind: "danger";
                        compact: true;
                        clicked => { Store.delete-group(Store.selected-group); }
                    }
                }
            }
        }

        // ---------------- entries
        Card {
            horizontal-stretch: 1;
            min-width: 300px;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        placeholder-text: "Search title, user, URL, tags...";
                        text <=> Store.search;
                        edited(t) => { Store.search-changed(t); }
                    }
                    VButton {
                        text: "New entry";
                        has-icon: true;
                        icon: @image-url("icons/plus.svg");
                        clicked => { Store.new-entry(); }
                    }
                }
                if Store.entries.length == 0: EmptyState {
                    title: "No entries";
                    text: "Store logins, passwords, API keys, SSH and server credentials. Everything is encrypted in a KeePass KDBX 4 file.";
                }
                ListView {
                    for e in Store.entries: Rectangle {
                        height: 54px;
                        border-radius: 8px;
                        background: Store.e-id == e.id ? Theme.blue-soft : eta.has-hover ? Theme.subtle : transparent;
                        eta := TouchArea { mouse-cursor: pointer; clicked => { Store.select-entry(e.id); } }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 10px;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 8px;
                                background: e.provider ? Theme.teal-soft : #eef2f8;
                                Image {
                                    source: e.provider ? @image-url("icons/key.svg") : @image-url("icons/lock.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: e.provider ? Theme.teal-dark : Theme.navy-3;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text { text: e.title; font-size: 13px; font-weight: 700; color: Theme.text; overflow: elide; }
                                Text { text: (e.username != "" ? e.username : "-") + (e.url != "" ? "   " + e.url : ""); font-size: 11px; color: Theme.muted; overflow: elide; }
                            }
                            if e.provider: VerticalLayout { alignment: center; Pill { text: "gateway key"; kind: "info"; } }
                            if e.expires != "": VerticalLayout { alignment: center; Pill { text: "exp " + e.expires; kind: "warn"; } }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: @image-url("icons/users.svg");
                                clicked => { Store.copy-username(e.id); }
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: @image-url("icons/copy.svg");
                                clicked => { Store.copy-password(e.id); }
                            }
                        }
                    }
                }
            }
        }

        // ---------------- editor
        Card {
            width: 380px;
            if !Store.editor-open: EmptyState {
                title: "Select an entry";
                text: "Copy buttons put the value on the clipboard and clear it automatically after a few seconds.";
            }
            if Store.editor-open: ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    alignment: start;
                    HorizontalLayout {
                        Text {
                            text: Store.e-id == "" ? "New entry" : "Edit entry";
                            font-size: 16px;
                            font-weight: 800;
                            color: Theme.text;
                        }
                        Rectangle { }
                        if Store.e-modified != "": Text { text: "modified " + Store.e-modified; font-size: 10px; color: Theme.faint; vertical-alignment: center; }
                    }
                    if Store.e-provider: Rectangle {
                        background: Theme.teal-soft;
                        border-radius: 8px;
                        height: pt.preferred-height + 16px;
                        pt := Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: "Gateway-managed provider key. It is used by the LLM gateway on behalf of approved clients and is never returned to API clients or AI agents.";
                            font-size: 11px;
                            color: Theme.green;
                            wrap: word-wrap;
                        }
                    }
                    Field { label: "TITLE"; text <=> Store.e-title; }
                    Field { label: "USER NAME"; text <=> Store.e-username; }
                    VerticalLayout {
                        spacing: 4px;
                        Label { text: "PASSWORD / SECRET"; }
                        HorizontalLayout {
                            spacing: 4px;
                            LineEdit {
                                text <=> Store.e-password;
                                input-type: Store.e-password-visible ? InputType.text : InputType.password;
                                placeholder-text: Store.e-id != "" && !Store.e-password-dirty ? "(unchanged)" : "";
                                edited => { Store.e-password-dirty = true; }
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: @image-url("icons/eye.svg");
                                clicked => { Store.reveal-password(); }
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: @image-url("icons/copy.svg");
                                clicked => { Store.copy-password(Store.e-id); }
                            }
                        }
                        Rectangle {
                            height: 4px;
                            border-radius: 2px;
                            background: #e6ebf3;
                            Rectangle {
                                x: 0;
                                width: parent.width * Store.strength(Store.e-password);
                                border-radius: 2px;
                                background: Store.strength(Store.e-password) < 0.35 ? Theme.red : Store.strength(Store.e-password) < 0.7 ? #e0a100 : Theme.teal;
                            }
                        }
                    }
                    Rectangle {
                        background: Theme.subtle;
                        border-radius: 8px;
                        height: gen.preferred-height;
                        gen := VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            HorizontalLayout {
                                Text { text: "Generator  ·  " + Store.gen-length + " chars"; font-size: 11px; font-weight: 700; color: Theme.muted; vertical-alignment: center; }
                                Rectangle { }
                                VButton {
                                    text: "Generate";
                                    compact: true;
                                    kind: "secondary";
                                    has-icon: true;
                                    icon: @image-url("icons/dice.svg");
                                    clicked => { Store.generate-password(); }
                                }
                            }
                            Slider {
                                minimum: 12;
                                maximum: 64;
                                value: Store.gen-length;
                                changed(v) => { Store.gen-length = Math.round(v); }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                CheckBox { text: "A-Z"; checked <=> Store.gen-upper; }
                                CheckBox { text: "0-9"; checked <=> Store.gen-digits; }
                                CheckBox { text: "!@#"; checked <=> Store.gen-symbols; }
                            }
                        }
                    }
                    Field { label: "URL"; text <=> Store.e-url; }
                    VerticalLayout {
                        spacing: 4px;
                        Label { text: "GROUP"; }
                        ComboBox {
                            model: Store.group-names;
                            current-index <=> Store.e-group-index;
                        }
                    }
                    Field { label: "TAGS (comma separated)"; text <=> Store.e-tags; }
                    Field { label: "EXPIRES (YYYY-MM-DD, optional)"; text <=> Store.e-expires; placeholder: "never"; }
                    VerticalLayout {
                        spacing: 4px;
                        Label { text: "NOTES"; }
                        TextEdit {
                            height: 90px;
                            text <=> Store.e-notes;
                            wrap: word-wrap;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        VButton { text: "Save"; kind: "primary"; clicked => { Store.save-entry(); } }
                        if Store.e-url != "": VButton {
                            text: "Open URL";
                            kind: "secondary";
                            has-icon: true;
                            icon: @image-url("icons/external.svg");
                            clicked => { Store.open-url(Store.e-url); }
                        }
                        Rectangle { }
                        if Store.e-id != "": VButton {
                            text: "Delete";
                            kind: "danger";
                            clicked => { Store.delete-entry(Store.e-id); }
                        }
                    }
                }
            }
        }
    }
}
