import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme, KpiTile, BarRow, Card, SectionTitle, Pill, EmptyState, VButton } from "widgets.slint";
import { Store, RequestItem } from "store.slint";

export component RequestRow inherits Rectangle {
    in property <RequestItem> r;
    in property <bool> compact: false;
    height: compact ? 44px : (r.error != "" ? 58px : 44px);
    background: ta.has-hover ? #f7f9fd : transparent;
    ta := TouchArea { }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            width: 118px;
            alignment: center;
            Text { text: r.ts; font-size: 11px; color: Theme.muted; }
            Text { text: r.endpoint; font-size: 10px; color: Theme.faint; }
        }
        VerticalLayout {
            alignment: center;
            min-width: 120px;
            horizontal-stretch: 1;
            Text { text: r.model; font-size: 13px; font-weight: 700; color: Theme.text; overflow: elide; }
            Text { text: r.provider; font-size: 11px; color: Theme.muted; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            min-width: 120px;
            horizontal-stretch: 1;
            Text { text: r.client; font-size: 12px; color: Theme.text; overflow: elide; }
            Text { text: r.agent + (r.project != "" ? "  ·  " + r.project : ""); font-size: 11px; color: Theme.muted; overflow: elide; }
        }
        if !compact: VerticalLayout {
            width: 96px;
            alignment: center;
            Pill {
                text: r.denied ? "denied" : r.ok ? "HTTP " + r.status : "HTTP " + r.status;
                kind: r.denied ? "warn" : r.ok ? "ok" : "bad";
            }
        }
        if !compact: VerticalLayout {
            width: 78px;
            alignment: center;
            Text { text: r.consent; font-size: 11px; color: Theme.muted; }
            Text { text: r.latency; font-size: 11px; color: Theme.faint; }
        }
        VerticalLayout {
            width: 110px;
            alignment: center;
            Text { text: r.tokens; font-size: 12px; color: Theme.text; horizontal-alignment: right; }
            Text { text: r.source; font-size: 10px; color: Theme.faint; horizontal-alignment: right; }
        }
        Text {
            width: 90px;
            text: r.cost;
            font-size: 12px;
            font-weight: 700;
            color: Theme.blue;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    if !compact && r.error != "": Text {
        x: 142px;
        y: parent.height - 18px;
        width: parent.width - 160px;
        text: r.error;
        font-size: 10px;
        color: r.denied ? Theme.amber : Theme.red;
        overflow: elide;
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #edf1f7;
    }
}

export component DashboardPage inherits Rectangle {
    background: Theme.bg;
    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: 24px;
            spacing: 18px;
            HorizontalLayout {
                spacing: 12px;
                SectionTitle {
                    title: "Overview";
                    subtitle: "Security, LLM calls, token usage and cost - all calls that went through the gateway.";
                }
                Rectangle { }
                ComboBox {
                    width: 150px;
                    model: ["Last 7 days", "Last 30 days", "Last 90 days", "Last 12 months"];
                    current-index <=> Store.period-index;
                    selected => { Store.refresh-dashboard(); }
                }
                VButton {
                    text: "Refresh";
                    kind: "secondary";
                    has-icon: true;
                    icon: @image-url("icons/refresh.svg");
                    clicked => { Store.refresh-dashboard(); }
                }
            }

            HorizontalLayout {
                spacing: 14px;
                KpiTile { label: "CALLS"; value: Store.kpi-calls; sub: Store.kpi-calls-sub; accent: Theme.blue; }
                KpiTile { label: "TOKENS"; value: Store.kpi-tokens; sub: Store.kpi-tokens-sub; accent: Theme.teal-dark; }
                KpiTile { label: "COST (" + Store.currency + ")"; value: Store.kpi-cost; sub: Store.kpi-cost-sub; accent: Theme.navy-3; }
                KpiTile { label: "LATENCY"; value: Store.kpi-latency; sub: Store.kpi-latency-sub; accent: Theme.amber; }
            }

            HorizontalLayout {
                spacing: 14px;
                Card {
                    horizontal-stretch: 3;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        SectionTitle { title: "Cost by provider"; subtitle: "Calculated from your versioned price lists"; }
                        for b[i] in Store.cost-by-provider: BarRow {
                            label: b.label;
                            value: b.value;
                            amount: b.amount;
                            sub: b.sub;
                            color: i == 0 ? Theme.blue : i == 1 ? Theme.teal : i == 2 ? #7f8fab : #a78bfa;
                        }
                        if Store.cost-by-provider.length == 0: EmptyState {
                            title: "No calls yet";
                            text: "Create a client token and point your agent at the gateway URL.";
                        }
                        Rectangle { }
                    }
                }
                Card {
                    horizontal-stretch: 2;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        SectionTitle { title: "Daily trend"; subtitle: "Cost per day"; }
                        HorizontalLayout {
                            height: 150px;
                            spacing: 2px;
                            for d in Store.daily: Rectangle {
                                Rectangle {
                                    y: parent.height - self.height;
                                    height: max(2px, parent.height * d.value);
                                    border-radius: 2px;
                                    background: d.value > 0 ? (bta.has-hover ? Theme.teal-dark : Theme.teal) : #e6ebf3;
                                }
                                bta := TouchArea { }
                                if bta.has-hover: Rectangle {
                                    y: -24px;
                                    x: -40px;
                                    width: 120px;
                                    height: 22px;
                                    border-radius: 5px;
                                    background: Theme.navy;
                                    Text { text: d.day + "  " + d.label; color: white; font-size: 10px; }
                                }
                            }
                        }
                        HorizontalLayout {
                            Text { text: Store.daily.length > 0 ? Store.daily[0].day : ""; font-size: 10px; color: Theme.faint; }
                            Rectangle { }
                            Text { text: Store.daily.length > 0 ? Store.daily[Store.daily.length - 1].day : ""; font-size: 10px; color: Theme.faint; }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;
                Card {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 8px;
                        SectionTitle { title: "Top models"; }
                        for b in Store.top-models: BarRow { label: b.label; value: b.value; amount: b.amount; sub: b.sub; color: Theme.navy-3; }
                        if Store.top-models.length == 0: Text { text: "-"; color: Theme.faint; }
                        Rectangle { }
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 8px;
                        SectionTitle { title: "Top agents / clients"; }
                        for b in Store.top-agents: BarRow { label: b.label; value: b.value; amount: b.amount; sub: b.sub; color: Theme.teal; }
                        if Store.top-agents.length == 0: Text { text: "-"; color: Theme.faint; }
                        Rectangle { }
                    }
                }
                Card {
                    width: 260px;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        SectionTitle { title: "Vault status"; }
                        HorizontalLayout { Text { text: "Vault"; color: Theme.muted; font-size: 12px; } Rectangle { } Pill { text: "unlocked"; kind: "ok"; } }
                        HorizontalLayout { Text { text: "Gateway"; color: Theme.muted; font-size: 12px; } Rectangle { } Pill { text: Store.gateway-url != "" ? "listening" : "stopped"; kind: Store.gateway-url != "" ? "ok" : "bad"; } }
                        HorizontalLayout { Text { text: "Passwords & keys"; color: Theme.muted; font-size: 12px; } Rectangle { } Text { text: Store.stat-entries; font-weight: 700; color: Theme.text; } }
                        HorizontalLayout { Text { text: "Providers"; color: Theme.muted; font-size: 12px; } Rectangle { } Text { text: Store.stat-providers; font-weight: 700; color: Theme.text; } }
                        HorizontalLayout { Text { text: "Model aliases"; color: Theme.muted; font-size: 12px; } Rectangle { } Text { text: Store.stat-models; font-weight: 700; color: Theme.text; } }
                        HorizontalLayout { Text { text: "Active clients"; color: Theme.muted; font-size: 12px; } Rectangle { } Text { text: Store.stat-clients; font-weight: 700; color: Theme.text; } }
                        HorizontalLayout { Text { text: "Standing consents"; color: Theme.muted; font-size: 12px; } Rectangle { } Text { text: Store.stat-rules; font-weight: 700; color: Theme.text; } }
                        Rectangle { }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 18px;
                    spacing: 8px;
                    HorizontalLayout {
                        SectionTitle { title: "Recent calls"; subtitle: "Metadata only - prompts and keys are never logged."; }
                        Rectangle { }
                        VButton {
                            text: "Open activity log";
                            kind: "secondary";
                            compact: true;
                            clicked => { Store.navigate(6); }
                        }
                    }
                    for r in Store.recent: RequestRow { r: r; compact: false; }
                    if Store.recent.length == 0: EmptyState {
                        title: "Nothing here yet";
                        text: "Requests from agents, scripts and IDEs will appear here.";
                    }
                }
            }
        }
    }
}
